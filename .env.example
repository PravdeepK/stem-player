# Copy to .env and fill in. .env is gitignored.

# Optional: force a specific Python interpreter (must have `demucs` installed).
# If unset, the app probes python3 / Homebrew / python.org builds automatically.
# STEM_PLAYER_PYTHON=/Library/Frameworks/Python.framework/Versions/3.13/bin/python3

# Optional: Hugging Face access token. Silences the "unauthenticated requests
# to the HF Hub" warning and raises the model-download rate limit.
# Create one at https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
